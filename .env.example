# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
#
# Both values come from your Supabase project:
#   Dashboard > Project Settings > API
#
# Use the ANON / PUBLIC key only. The service_role key bypasses row-level
# security and must never appear in a NEXT_PUBLIC_* variable, because
# anything NEXT_PUBLIC_* is compiled into the browser bundle.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
